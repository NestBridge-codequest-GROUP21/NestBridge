# NestBridge environment (copy to .env in frontend/ or repo root)

# API base URL — use 10.0.2.2 for Android emulator, localhost for iOS sim, LAN IP for physical device
API_BASE_URL=http://localhost:8080

# Backend (application-dev.properties overrides)
DB_URL=jdbc:postgresql://localhost:5432/nestbridge
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=nestbridge-dev-secret-key-min-256-bits-for-hs256-signing!!

# Firebase (optional — chat provisioning)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# Demo seed accounts (password: password)
# akosua.demo@nestbridge.app
# james.demo@nestbridge.app
# abena.host@nestbridge.app
