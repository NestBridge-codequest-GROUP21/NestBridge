# NestBridge environment (copy to .env in repo root or configure in your host)

# --- Backend (production) ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://HOST:5432/nestbridge
DB_USER=postgres
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=
# Public API URL used in verification / reset email links (must match Railway HTTPS domain)
APP_PUBLIC_URL=https://nestbridge-production.up.railway.app
CORS_ALLOWED_ORIGINS=https://nestbridge-production.up.railway.app

# Email verification (SendGrid)
# Required when EMAIL_VERIFICATION_ENABLED=true AND you want real inbox mail.
# If SENDGRID_API_KEY is missing, the API auto-verifies new accounts so users are not locked out.
# EMAIL_FROM must be a Verified Sender (or on an authenticated domain) in SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM=noreply@nestbridge.app
EMAIL_FROM_NAME=NestBridge
EMAIL_VERIFICATION_ENABLED=true

# Staff auto-grant at registration (comma-separated, case-insensitive).
# If unset/blank, backend defaults to:
# bsbhackman@gmail.com,abdulsamedtaslima@gmail.com,angelonwe54@gmail.com
# After changing on Railway, restart the service (no code redeploy).
ADMIN_EMAIL_ALLOWLIST=

# Paystack (Ghana payments — cards + Mobile Money)
# Set PAYSTACK_ENABLED=true and paste the Live/Test Secret Key.
# Configure webhook: {APP_PUBLIC_URL}/api/webhooks/paystack (charge.success).
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=

# AWS S3 profile photos (optional)
AWS_S3_ENABLED=false
AWS_S3_BUCKET=
AWS_S3_REGION=eu-west-1
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Frontend (EAS / Expo production build) ---
# Set in app.config.ts extra or EAS secrets
API_BASE_URL=https://api.nestbridge.app

# Firebase Realtime Database (optional — live chat sync)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_DATABASE_URL=
SUPPORT_ALERT_EMAIL=

# --- Local development defaults ---
# DB_URL=jdbc:postgresql://localhost:5432/nestbridge
# DB_USER=postgres
# DB_PASSWORD=postgres
# REDIS_HOST=localhost
# JWT_SECRET=nestbridge-dev-secret-key-min-256-bits-for-hs256-signing!!
# APP_PUBLIC_URL=http://localhost:8080
# Without SENDGRID_API_KEY and EMAIL_VERIFICATION_ENABLED=true, registration keeps the
# account but reports emailDeliveryFailed so the app can offer Resend.
# Local tip: set EMAIL_VERIFICATION_ENABLED=false to skip inbox during development.

SMILE_ENABLED=false
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_CALLBACK_URL=
SMILE_ENVIRONMENT=sandbox

# Demo fallback in mobile app (EAS): true for judges, false for real users
# Also controls demo quick-login tabs on Welcome / Login / Register.
EXPO_PUBLIC_ENABLE_DEMO_FALLBACK=true

# Demo seed accounts (password: password)
# akosua.demo@nestbridge.app
# zara.tourist@nestbridge.app
# abena.host@nestbridge.app
# kofi.guide@nestbridge.app
