# NestBridge environment (copy to .env in frontend/ or repo root)

# API base URL (optional). Leave unset in app.json so Expo Go auto-uses the Metro LAN IP:8080.
# Only set expo.extra.apiBaseUrl to a real host if needed — never localhost on a physical phone.
API_BASE_URL=http://localhost:8080

# Backend (application-dev.properties overrides)
DB_URL=jdbc:postgresql://localhost:5432/nestbridge
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=nestbridge-dev-secret-key-min-256-bits-for-hs256-signing!!

# Firebase Realtime Database (optional — enables live chat sync across devices)
# 1. Create project at https://console.firebase.google.com
# 2. Enable Realtime Database
# 3. Add a Web app and copy values below for Expo
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Backend Firebase Admin (service account JSON path)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_DATABASE_URL=

# Demo seed accounts (password: password) — optional shortcuts only
# akosua.demo@nestbridge.app
# james.demo@nestbridge.app
# abena.host@nestbridge.app
# kofi.guide@nestbridge.app
